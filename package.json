{
  "name": "xxl-job-dbx-plugin",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:release": "node --test scripts/test-release-contract.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:all": "npm run build && node scripts/package.mjs all"
  },
  "dependencies": {
    "@lucide/vue": "1.46.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.1.0"
  }
}
